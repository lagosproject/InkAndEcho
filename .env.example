# Google Play Console / API Developer credentials (for automated publishing)
PLAY_CONSOLE_PACKAGE_NAME=com.LakesCorp.FunCoStory
PLAY_CONSOLE_SERVICE_ACCOUNT_JSON_PATH=<PATH_TO_YOUR_JSON_KEY_FILE>

# App Signing configurations (if not using local keystore.properties)
RELEASE_KEY_ALIAS=<YOUR_KEY_ALIAS>
RELEASE_KEY_PASSWORD=<YOUR_KEY_PASSWORD>
RELEASE_STORE_FILE=<YOUR_STORE_FILE_PATH>
RELEASE_STORE_PASSWORD=<YOUR_STORE_PASSWORD>

# Optional API Integrations (e.g., Firebase, Crashlytics, or analytics)
FIREBASE_API_KEY=<YOUR_FIREBASE_API_KEY>
FIREBASE_PROJECT_ID=<YOUR_FIREBASE_PROJECT_ID>
